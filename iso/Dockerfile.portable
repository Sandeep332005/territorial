# ============================================================
# ABHIMANYU X Platform - Portable Docker Image
# Works on: Windows, Mac, Linux with Docker
# ============================================================

FROM python:3.11-slim

# Labels
LABEL maintainer="ABHIMANYU X Team"
LABEL description="Autonomous Cyber Reasoning System for Defence Infrastructure"
LABEL version="2.0"

# Set environment
ENV PYTHONUNBUFFERED=1
ENV ABHIMANYUX_HOME=/opt/abhimanyux
ENV PATH="${ABHIMANYUX_HOME}:${PATH}"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Copy ABHIMANYU X
WORKDIR ${ABHIMANYUX_HOME}
COPY core/ ${ABHIMANYUX_HOME}/core/
COPY platform/ ${ABHIMANYUX_HOME}/platform/
COPY rewind/ ${ABHIMANYUX_HOME}/rewind/
COPY fuzzer/ ${ABHIMANYUX_HOME}/fuzzer/
COPY anvil/ ${ABHIMANYUX_HOME}/anvil/
COPY verifier/ ${ABHIMANYUX_HOME}/verifier/
COPY memory/ ${ABHIMANYUX_HOME}/memory/
COPY models/ ${ABHIMANYUX_HOME}/models/
COPY requirements.txt ${ABHIMANYUX_HOME}/

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Create launcher script
RUN echo '#!/bin/bash' > /usr/local/bin/abhimanyux && \
    echo 'ABHIMANYUX_HOME="/opt/abhimanyux"' >> /usr/local/bin/abhimanyux && \
    echo 'case "$1" in' >> /usr/local/bin/abhimanyux && \
    echo '    scan)' >> /usr/local/bin/abhimanyux && \
    echo '        cd "$ABHIMANYUX_HOME"' >> /usr/local/bin/abhimanyux && \
    echo '        PYTHONPATH=. python -m abhimanyux.platform.abhimanyux_platform "$2"' >> /usr/local/bin/abhimanyux && \
    echo '        ;;' >> /usr/local/bin/abhimanyux && \
    echo '    setup)' >> /usr/local/bin/abhimanyux && \
    echo '        echo "Pulling recommended model..."' >> /usr/local/bin/abhimanyux && \
    echo '        ollama pull qwen2.5-coder:7b-instruct-q4_K_M' >> /usr/local/bin/abhimanyux && \
    echo '        echo "Setup complete!"' >> /usr/local/bin/abhimanyux && \
    echo '        ;;' >> /usr/local/bin/abhimanyux && \
    echo '    *)' >> /usr/local/bin/abhimanyux && \
    echo '        echo "ABHIMANYU X Platform v2.0"' >> /usr/local/bin/abhimanyux && \
    echo '        echo "Usage: abhimanyux {scan|setup} [target]"' >> /usr/local/bin/abhimanyux && \
    echo '        ;;' >> /usr/local/bin/abhimanyux && \
    echo 'esac' >> /usr/local/bin/abhimanyux && \
    chmod +x /usr/local/bin/abhimanyux

# Expose ports
EXPOSE 11434 8000

# Create startup script inline
RUN echo '#!/bin/bash' > /start_services.sh && \
    echo 'set -e' >> /start_services.sh && \
    echo 'echo "ABHIMANYU X Platform v2.0"' >> /start_services.sh && \
    echo 'OLLAMA_HOST=0.0.0.0:11434 ollama serve &' >> /start_services.sh && \
    echo 'sleep 5' >> /start_services.sh && \
    echo 'echo "Services started"' >> /start_services.sh && \
    echo 'if [ $# -gt 0 ]; then abhimanyux "$@"; else wait; fi' >> /start_services.sh && \
    chmod +x /start_services.sh

ENTRYPOINT ["/start_services.sh"]
