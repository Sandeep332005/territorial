#!/bin/sh
# ============================================================
# ABHIMANYU X Live Boot - Init Script
# Minimal Linux init that boots directly into ABHIMANYU X
# ============================================================

# Mount essential filesystems
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /var/run

# Set hostname
echo "abhimanyux" > /proc/sys/kernel/hostname

# Clear screen
clear

echo ""
echo "  _____ ____  ___    _    ______   _______   ____ "
echo " / ____/ ___||_ _|  / \  | __ ) \ / / ____| / ___|"
echo "| |    \___ \ | |  / _ \ |  _ \\ V /|  _|   \___ \ "
echo "| |___  ___) || | / ___ \| |_) || | | |___   ___) |"
echo " \____||____/___/_/   \_\____/ |_|  |_____| |____/ "
echo ""
echo " Autonomous Cyber Reasoning System v2.0"
echo " Defence Infrastructure Security"
echo ""
echo "============================================================"
echo ""

# Detect hardware
echo "[*] Detecting hardware..."

# CPU
CPU_MODEL=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
CPU_CORES=$(nproc 2>/dev/null || echo "unknown")
echo "  CPU: ${CPU_MODEL:-Unknown} ($CPU_CORES cores)"

# RAM
RAM_KB=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}')
RAM_GB=$((RAM_KB / 1024 / 1024))
echo "  RAM: ${RAM_GB} GB"

# GPU
if command -v lspci > /dev/null 2>&1; then
    GPU_INFO=$(lspci 2>/dev/null | grep -i vga | head -1)
    echo "  GPU: ${GPU_INFO:-Not detected}"
fi

# Storage
echo "  Storage: $(lsblk -d -o NAME,SIZE 2>/dev/null | tail -n +2 | head -5)"
echo ""

# Start Ollama in background
echo "[*] Starting Ollama LLM server..."
export OLLAMA_HOST=0.0.0.0:11434
export OLLAMA_MODELS=/opt/abhimanyux/models

# Check if Ollama exists
if [ -f /opt/ollama/ollama ]; then
    /opt/ollama/ollama serve &
    OLLAMA_PID=$!
    sleep 3
    
    if kill -0 $OLLAMA_PID 2>/dev/null; then
        echo "  [OK] Ollama running on port 11434"
    else
        echo "  [!] Ollama failed to start"
    fi
else
    echo "  [!] Ollama not found - AI features disabled"
fi

echo ""

# Auto-select model based on hardware
echo "[*] Configuring optimal model..."

if [ "$RAM_GB" -ge 32 ]; then
    RECOMMENDED_MODEL="qwen2.5-coder:32b-instruct-q4_K_M"
    MODEL_SIZE="32B"
elif [ "$RAM_GB" -ge 16 ]; then
    RECOMMENDED_MODEL="qwen2.5-coder:7b-instruct-q4_K_M"
    MODEL_SIZE="7B"
elif [ "$RAM_GB" -ge 8 ]; then
    RECOMMENDED_MODEL="qwen3:8b"
    MODEL_SIZE="8B"
else
    RECOMMENDED_MODEL="qwen2.5-coder:3b"
    MODEL_SIZE="3B"
fi

echo "  Recommended: $RECOMMENDED_MODEL ($MODEL_SIZE)"

# Check if model is available
if command -v /opt/ollama/ollama > /dev/null 2>&1; then
    AVAILABLE_MODELS=$(/opt/ollama/ollama list 2>/dev/null | grep -o "^[^ ]*" | head -5)
    if [ -n "$AVAILABLE_MODELS" ]; then
        echo "  Available models:"
        echo "$AVAILABLE_MODELS" | while read model; do
            echo "    - $model"
        done
        
        # Use first available model
        ACTIVE_MODEL=$(echo "$AVAILABLE_MODELS" | head -1)
        echo "  Active: $ACTIVE_MODEL"
    else
        echo "  No models downloaded yet"
        echo "  Run: ollama pull $RECOMMENDED_MODEL"
    fi
fi

echo ""

# Create abhimanyux command
cat > /usr/local/bin/abhimanyux << 'LAUNCHER'
#!/bin/sh
SENTINELX_HOME="/opt/abhimanyux"

case "$1" in
    scan)
        if [ -z "$2" ]; then
            echo "Usage: abhimanyux scan <file_or_directory>"
            exit 1
        fi
        
        echo "Scanning: $2"
        echo ""
        
        cd "$SENTINELX_HOME"
        python3 -m abhimanyux.platform.abhimanyux_platform "$2"
        ;;
    models)
        echo "Available models:"
        echo ""
        if command -v ollama > /dev/null 2>&1; then
            ollama list
        else
            echo "Ollama not available"
        fi
        ;;
    hardware)
        echo "Hardware Information:"
        echo "  CPU: $(grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)"
        echo "  Cores: $(nproc)"
        echo "  RAM: $(free -h | grep Mem | awk '{print $2}')"
        echo "  GPU: $(lspci 2>/dev/null | grep -i vga | head -1 || echo 'Not detected')"
        ;;
    pull)
        if [ -z "$2" ]; then
            echo "Usage: abhimanyux pull <model_name>"
            exit 1
        fi
        echo "Pulling model: $2"
        ollama pull "$2"
        ;;
    web)
        echo "Starting ABHIMANYU X Web Dashboard..."
        cd "$SENTINELX_HOME"
        python3 -m uvicorn api.server:app --host 0.0.0.0 --port 8000
        ;;
    *)
        echo "ABHIMANYU X Platform v2.0"
        echo "Autonomous Cyber Reasoning System"
        echo ""
        echo "Usage: abhimanyux <command> [options]"
        echo ""
        echo "Commands:"
        echo "  scan <target>    Scan file or directory for vulnerabilities"
        echo "  models          List available LLM models"
        echo "  hardware        Show hardware information"
        echo "  pull <model>    Download an Ollama model"
        echo "  web             Start web dashboard on port 8000"
        echo ""
        echo "Examples:"
        echo "  abhimanyux scan /path/to/code"
        echo "  abhimanyux pull qwen2.5-coder:7b"
        echo "  abhimanyux web"
        ;;
esac
LAUNCHER
chmod +x /usr/local/bin/abhimanyux

# Show welcome message
echo "============================================================"
echo "SYSTEM READY"
echo "============================================================"
echo ""
echo "Quick start commands:"
echo "  abhimanyux scan /path/to/project   - Scan for vulnerabilities"
echo "  abhimanyux models                  - List available models"
echo "  abhimanyux hardware                - Show hardware info"
echo "  abhimanyux pull qwen2.5-coder:7b   - Download AI model"
echo "  abhimanyux web                     - Start web dashboard"
echo ""
echo "AbhimanyuX is ready. Type 'abhimanyux' for help."
echo ""

# Drop to shell
exec /bin/sh
