{
  "_comment": "ABHIMANYU X Provider Configuration",
  
  "active_provider": "auto",
  
  "local": {
    "ollama": {
      "enabled": true,
      "endpoint": "http://localhost:11434",
      "default_model": "qwen2.5-coder:7b-instruct-q4_K_M",
      "auto_start": true
    },
    "vllm": {
      "enabled": false,
      "endpoint": "http://localhost:8000/v1",
      "default_model": "codellama/CodeLlama-34b-Instruct-hf"
    },
    "lm_studio": {
      "enabled": false,
      "endpoint": "http://localhost:1234/v1",
      "default_model": "local-model"
    }
  },
  
  "api": {
    "anthropic": {
      "enabled": false,
      "api_key_env": "ANTHROPIC_API_KEY",
      "default_model": "claude-sonnet-4-20250514",
      "priority": 1
    },
    "openai": {
      "enabled": false,
      "api_key_env": "OPENAI_API_KEY",
      "default_model": "gpt-4o",
      "priority": 2
    },
    "google": {
      "enabled": false,
      "api_key_env": "GEMINI_API_KEY",
      "default_model": "gemini-2.5-flash",
      "priority": 3
    },
    "deepseek": {
      "enabled": false,
      "api_key_env": "DEEPSEEK_API_KEY",
      "default_model": "deepseek-chat",
      "priority": 4
    },
    "groq": {
      "enabled": false,
      "api_key_env": "GROQ_API_KEY",
      "default_model": "llama-3.1-8b-instant",
      "priority": 5
    },
    "mistral": {
      "enabled": false,
      "api_key_env": "MISTRAL_API_KEY",
      "default_model": "mistral-large-latest",
      "priority": 6
    },
    "together": {
      "enabled": false,
      "api_key_env": "TOGETHER_API_KEY",
      "default_model": "Qwen/Qwen2.5-72B-Instruct-Turbo",
      "priority": 7
    }
  },
  
  "custom": {
    "endpoints": [
      {
        "name": "my-local-server",
        "enabled": false,
        "api_url": "http://192.168.1.100:8080/v1/chat/completions",
        "model_id": "my-model",
        "api_key": null,
        "description": "My self-hosted model"
      },
      {
        "name": "company-proxy",
        "enabled": false,
        "api_url": "https://ai.company.com/api/v1/chat/completions",
        "model_id": "company-model",
        "api_key": "your-api-key-here",
        "description": "Company AI proxy"
      },
      {
        "name": "text-generation-webui",
        "enabled": false,
        "api_url": "http://localhost:5000/v1/chat/completions",
        "model_id": "model",
        "api_key": null,
        "description": "Text Generation WebUI"
      },
      {
        "name": "koboldcpp",
        "enabled": false,
        "api_url": "http://localhost:5001/v1/chat/completions",
        "model_id": "model",
        "api_key": null,
        "description": "KoboldCpp server"
      },
      {
        "name": "llama.cpp-server",
        "enabled": false,
        "api_url": "http://localhost:8080/v1/chat/completions",
        "model_id": "model",
        "api_key": null,
        "description": "llama.cpp server"
      }
    ]
  },
  
  "fallback": {
    "enabled": true,
    "chain": ["local", "api", "custom"],
    "max_retries": 3,
    "retry_delay": 1.0
  },
  
  "selection": {
    "prefer_local": true,
    "prefer_cheap": false,
    "auto_select": true,
    "task_weights": {
      "vulnerability_detection": {
        "code": 2.0,
        "security": 1.5,
        "recommended": 1.2
      },
      "patch_generation": {
        "code": 2.0,
        "security": 1.5
      },
      "root_cause_analysis": {
        "reasoning": 2.0,
        "best": 1.5
      }
    }
  }
}
